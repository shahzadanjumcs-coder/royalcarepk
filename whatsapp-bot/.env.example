# RoyalCarePK WhatsApp bot — environment template
# Copy to .env and fill in. NEVER commit the real .env.
# The bot talks to Supabase directly (same project as the web app) and needs
# NOTHING else — no webhook URLs, no web-app credentials.

# Supabase project (Supabase Dashboard → Project Settings → API)
SUPABASE_URL=https://YOUR-PROJECT.supabase.co
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key

# Where Baileys multi-file auth sessions are stored (persists across restarts
# ONLY if this directory lives on persistent disk — do not run on Vercel).
WHATSAPP_SESSION_DIR=./sessions

# Health endpoint port (GET / → {ok, uptime_s, sessions, stats}; for pm2/uptime monitors)
PORT=3088

# pino log level (trace|debug|info|warn|error)
LOG_LEVEL=info
